APP_NAME=Digi-Dan
CORS_ORIGINS=
ALLOWED_ORIGIN_DOMAINS=
API_BYPASS_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_NAMESPACE=default

BOT_ADMIN_TOKEN=
DEFAULT_PROVIDER=gemini
GENERATION_FALLBACK_ENABLED=true
GENERATION_TIMEOUT_SECONDS=20
GENERATION_TOTAL_TIMEOUT_SECONDS=40
RETRIEVAL_TOP_K=4
MAX_CONTEXT_CHARS=6000
CHAT_RATE_LIMIT=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=3600
# Compatibility defaults only; see docs/shared-rate-limiting.md before production cutover.
CHAT_RATE_LIMIT_BACKEND=memory
CHAT_CLIENT_IDENTITY_MODE=legacy
CHAT_LOCAL_CLIENT_ID=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Separate restricted limiter credential; never substitute the knowledge worker token.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
RATE_LIMIT_REDIS_TIMEOUT_SECONDS=2

# Isolated cloud preparation; leave the deployed chatbot in legacy mode.
KNOWLEDGE_MODE=legacy
KNOWLEDGE_ENVIRONMENT=test
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
